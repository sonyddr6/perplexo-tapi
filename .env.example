# ==================================
# Perplexo Bot - Variáveis de Ambiente
# ==================================
# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example .env

# Token de sessão do Perplexity.ai
# Como obter: Login em perplexity.ai > F12 > Application > Cookies > Copie o token de sessão
PERPLEXITY_SESSION_TOKEN=seu_token_de_sessao_aqui

# === TOKEN MANAGER (opcional - recomendado para múltiplas contas) ===
# Arquivo JSON com cookies/tokens (veja data/tokens/cookies.json.example)
# PERPLEXITY_COOKIES_FILE=./data/tokens/cookies.json

# Habilitar rotação automática entre contas
# TOKEN_ROTATION_ENABLED=true

# Token do bot do Telegram
# Como obter: Fale com @BotFather no Telegram e crie um novo bot
TELEGRAM_TOKEN=seu_token_telegram_aqui

# Portas dos serviços (não altere a menos que tenha conflito)
MCP_PORT=5000
TELEGRAM_PORT=8000

# URL da API MCP (use o nome do serviço Docker para comunicação interna)
MCP_API_URL=http://perplexo-bot:5000

# Ambiente Flask
FLASK_ENV=production

# (Opcional) URL do Webhook para Telegram
# Deixe vazio para usar polling (desenvolvimento)
# WEBHOOK_URL=https://seu-dominio.com/telegram

# === TTS INWORLD (opcional - para RESPOSTA_SIMPLES) ===
# Token da Inworld AI (expira em ~1h, será renovado automaticamente)
# Se não tiver, configure o FIREBASE_REFRESH_TOKEN abaixo
# INWORLD_TOKEN=eyJraWQi...token_aqui

# Para auto-renovação de token:
# FIREBASE_API_KEY=AIzaSy...sua_firebase_api_key_aqui
# FIREBASE_REFRESH_TOKEN=AMf-vBwy...seu_refresh_token_aqui

# Workspace e Voz padrão
# WORKSPACE_ID=default--xxxxxxxxxxxxx
# TTS_VOICE_ID=default--xxxxxxxxxxxxx__voice_name
